{
  "name": "shx-lead-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "[ -f .env ] && set -a && . ./.env; set +a; printf '@FO-Enablement-Vivint:registry=https://npm.pkg.github.com\\n' > .npmrc && if [ -n \"$NPM_AUTH_TOKEN\" ]; then printf '//npm.pkg.github.com/:_authToken=%s\\n' \"$NPM_AUTH_TOKEN\" >> .npmrc; fi",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "schema:generate": "tsx scripts/generate-airtable-schema.ts",
    "db:check": "tsx scripts/check-login-log.ts",
    "auth:check": "tsx scripts/check-roster-gate.ts",
    "zips:sync": "tsx --env-file=.env scripts/sync-zip-centroids.ts",
    "leads:undo": "tsx --env-file=.env scripts/undo-lead-load.ts"
  },
  "dependencies": {
    "@FO-Enablement-Vivint/magistrate": "^1.0.6",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.6",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.469.0",
    "next": "^16.3.7",
    "next-themes": "^0.4.4",
    "openai": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.0.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "use-debounce": "^10.0.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
