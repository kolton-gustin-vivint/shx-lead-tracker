# ── Airtable ─────────────────────────────────────────────────────────────────
# Personal access token with data.records:read, data.records:write and
# schema.bases:read (schema scope is only needed for `npm run schema:generate`).
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=apphPJFvk2oPNeJK9

# ── OpenAI (AI summary / next-action suggestions) ────────────────────────────
OPENAI_API_KEY=sk-...

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
# Public origin of this server. Used for OIDC redirect URIs and for building
# attachment URLs that Airtable must be able to fetch.
PUBLIC_URL=http://localhost:3001
# In dev the Vite app runs on its own origin; auth redirects go back here.
WEB_URL=http://localhost:5173
# Long random string used to sign the session cookie.
SESSION_SECRET=change-me
SESSION_TTL_HOURS=168

# ── Auth ─────────────────────────────────────────────────────────────────────
# "oidc" for real sign-in (Google Workspace, Microsoft Entra, Okta, …)
# "dev"  for a local email-only login form (refused when NODE_ENV=production)
AUTH_MODE=dev
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional comma-separated allowlist of email domains, e.g. vivint.com
ALLOWED_EMAIL_DOMAINS=

# ── Storage ──────────────────────────────────────────────────────────────────
DATA_DIR=./data
UPLOAD_DIR=./uploads
