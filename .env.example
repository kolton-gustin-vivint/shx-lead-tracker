# ── Airtable ─────────────────────────────────────────────────────────────────
# Personal access token with data.records:read, data.records:write and
# schema.bases:read (schema scope is only needed for `npm run schema:generate`).
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=apphPJFvk2oPNeJK9

# ── OpenAI (AI summary / next-action suggestions) ────────────────────────────
OPENAI_API_KEY=sk-...

# ── Server ───────────────────────────────────────────────────────────────────
# Public origin of this app. Used to build attachment URLs that Airtable must
# be able to fetch. On Vercel this defaults to the production domain.
PUBLIC_URL=http://localhost:3000

# ── Current user (no authentication yet) ─────────────────────────────────────
# The app has no sign-in. Every request is served as this SHX Team member, and
# their Role decides whether manager-only screens appear. Must match a row in
# the SHX Team table. Replace this with real auth before exposing the app.
APP_USER_EMAIL=you@vivint.com

# ── Storage ──────────────────────────────────────────────────────────────────
DATA_DIR=./data
UPLOAD_DIR=./uploads
